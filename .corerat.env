# CoreRaT environment configuration
#
# This file is committed to git.  It provides defaults for local development
# and is sourced by scripts/evl-dev.sh.
#
# Non-secret values only.  Tokens and credentials belong in CI secrets or
# your local shell profile, never here.
#
# To override values for your machine without touching this file, create
# .corerat.env.local (gitignored) with only the variables you want to change.
#
# These values are also hardcoded in any CI workflow that references the
# RaTOS image.  Keep them in sync when the RaTOS image changes.

# RaTOS developer container image (public GHCR, no authentication required)
RATOS_IMAGE_REF=ghcr.io/mattih11/ratos-dev-image:latest

# RaTOS GitHub repository used to locate SDK and QEMU artifacts
# Must be "owner/repo" format for the gh CLI
RATOS_RELEASE_REPO=mattih11/RaTOS

# Pinned RaTOS release tag — must be compatible with this version of CoreRaT.
# Update this (and test) when upgrading RaTOS.  Override in .corerat.env.local
# to test against a newer or pre-release version without touching this file.
# Leave unset to fall back to the latest successful run on main (CI/dev only).
RATOS_RELEASE_TAG=v0.0.7

# QEMU resource defaults (adjust for your host machine)
QEMU_MEMORY=2G
QEMU_CPUS=4
